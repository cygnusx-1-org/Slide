<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:paddingBottom="16dp"
              android:paddingTop="16dp">

    <androidx.cardview.widget.CardView android:id="@+id/layout"
                                        xmlns:cardview="http://schemas.android.com/apk/res-auto"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="20dp"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        cardview:cardBackgroundColor="@android:color/black"
                                        cardview:cardCornerRadius="2dp"
                                        cardview:cardElevation="8dp">


        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:selectableItemBackground"
                android:orientation="vertical">

            <!-- Hidden by default: an empty TextView still lays out one line, so a row whose adapter
                 has no title to show would reserve its padding and line height as blank space. Every
                 adapter that has a title makes this visible itself. -->
            <me.edgan.redditslide.SpoilerRobotoTextView
                    android:id="@+id/imagetitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textColor="#fff"
                    android:textSize="14sp"
                    android:visibility="gone">

            </me.edgan.redditslide.SpoilerRobotoTextView>

            <!-- adjustViewBounds is not decorative: when the entry reports no dimensions the adapter
                 calls setAspectRatio(0), and MaxHeightImageView then falls through to ImageView,
                 which needs this to derive a height that keeps the image's aspect ratio. -->
            <me.edgan.redditslide.Views.MaxHeightImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:cropToPadding="false"
                   />

            <me.edgan.redditslide.SpoilerRobotoTextView
                    android:id="@+id/imageCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"

                    android:textColor="#fff"
                    android:textSize="12sp">

            </me.edgan.redditslide.SpoilerRobotoTextView>


        </LinearLayout>

    </androidx.cardview.widget.CardView>
</LinearLayout>
