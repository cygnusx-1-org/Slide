<resources>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>

    <dimen name="app_defaultsize_w">632.0dip</dimen>

    <dimen name="app_defaultsize_h">598.0dip</dimen>

    <dimen name="app_minimumsize_w">632.0dip</dimen>

    <dimen name="app_minimumsize_h">598.0dip</dimen>
    <dimen name="overview_top_padding_single">56dp</dimen>

    <!-- Material Design's dimension for a standard toolbar -->
    <dimen name="standard_toolbar_height">56dp</dimen>

    <!-- Big thumbnails -->
    <dimen name="big_thumbnail_width">100dp</dimen>
    <dimen name="big_thumbnail_height">70dp</dimen>

    <!-- Small thumbnails -->
    <dimen name="small_thumbnail_width">65dp</dimen>
    <dimen name="small_thumbnail_height">65dp</dimen>

    <!-- Outer gap for a vertical album/gallery row. Mirrors album_image.xml's 16dp root padding
         and 20dp CardView bottom margin so image rows and video rows line up. -->
    <dimen name="album_row_margin_top">16dp</dimen>
    <dimen name="album_row_margin_bottom">36dp</dimen>

    <!-- Starting collapsed height of submission_albumcard.xml's info panel, used until the panel has
         laid out: BaseAlbumFull then replaces it with the measured height of @id/title and pads its
         RecyclerView by the same amount, since the panel is umanoOverlay and covers that much of the
         list. Only the layout reads this — do not pad a list by it, because by the time rows are
         bound the real panel height is whatever that measurement produced. -->
    <dimen name="album_card_panel_height">96dp</dimen>

    <!-- Height of the @id/gifheader button bar that the media hosts pin to the bottom of a video
         (activity_media.xml, submission_gifcard_album.xml), and the bottom margin ExoVideoView gives
         its transport controls to clear that bar. Paired deliberately: the margin has to stay the
         larger of the two, or the seek bar lands behind the buttons. -->
    <dimen name="gif_header_height">56dp</dimen>
    <dimen name="video_controls_bottom_margin">64dp</dimen>
</resources>
